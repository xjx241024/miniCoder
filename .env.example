# 复制本文件为 .env 并填入真实配置
LLM_PROVIDER=openai
LLM_MODEL_ID=gpt-4o-mini
LLM_API_KEY=
# OpenAI 兼容接口地址示例：
# DeepSeek: https://api.deepseek.com/v1
# 通义千问: https://dashscope.aliyuncs.com/compatible-mode/v1
# 智谱:     https://open.bigmodel.cn/api/paas/v4
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.2
# 失败重试：重试次数上限与退避基数（秒），第 n 次等待 base * 2^n
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF=1.0
# 流式请求是否请求服务端返回 usage（含前缀缓存命中数），用于 M10 缓存观测；
# 个别网关不支持 stream_options 时设为 0 关闭
LLM_STREAM_INCLUDE_USAGE=1

# ---- RAG（M11）----
# Embedding 服务与 LLM 相互独立：LLM 可用 DeepSeek，向量用 SiliconFlow
# SiliconFlow: https://api.siliconflow.cn/v1（模型 BAAI/bge-m3，1024 维）
# OpenAI:     https://api.openai.com/v1（模型 text-embedding-3-small，1536 维）
EMBEDDING_PROVIDER=siliconflow
EMBEDDING_MODEL_ID=BAAI/bge-m3
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_TIMEOUT=60
EMBEDDING_MAX_RETRIES=2
EMBEDDING_RETRY_BACKOFF=1.0
# 单次请求最大文本数（批量向量化，降低请求次数）
EMBEDDING_MAX_BATCH=32
# 分块目标大小（字符）与相邻块重叠
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
# 单文件最大索引字符数（约 200k，防止超大文件拖慢索引）
RAG_INDEX_MAX_CHARS=200000

# ---- 上下文工程（M6）----
# 上下文预算上限（估算 token）
CONTEXT_MAX_TOKENS=32000
# 水位阈值比例：估算 token 达预算该比例即触发 compact
CONTEXT_COMPACT_RATIO=0.8
# compact 后保留的最近对话单元数
CONTEXT_KEEP_TURNS=20
# 是否读取 AGENTS.md / .minicoder/context.md（L2 项目规则）
CONTEXT_PROJECT_FILES=1
# 是否注入文件地图（L2）
CONTEXT_REPO_MAP=1
# 文件地图最大行数
CONTEXT_REPO_MAP_MAX_LINES=150

# ---- 安全边界（M7）----
# Bash 审批策略：ask=中高危询问 / allow=只拒绝高危 / deny=只放行只读（非交互默认 deny）
SECURITY_ASK_POLICY=ask
# 会话内是否记住审批选择，避免同一命令反复询问
SECURITY_REMEMBER_CHOICES=1

# ---- 会话保留（M8）----
# 数据存放目录：~/.minicoder（可用 MINICODER_DATA_DIR 覆盖）；
# MINICODER_DATA_DIR=
# 清理阈值如下：
# 保留最近多少个会话（超出裁剪）
RETENTION_KEEP_SESSIONS=30
# 运行文件（trace / transcript / artifact）超过多少天视为过期
RETENTION_MAX_AGE_DAYS=30
